{
  "expo": {
    "name": "RNAA Stress Test",
    "slug": "rnaa-stress-test",
    "scheme": "rnaa-stress-test",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rnaaworkshop.stresstest"
    },
    "android": {
      "package": "com.rnaaworkshop.stresstest",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "platforms": ["ios", "android"],
    "plugins": [
      "expo-dev-client",
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": true,
          "iosMicrophonePermission": "Allow RNAA Stress Test to use the microphone for audio recording functional tests.",
          "androidPermissions": [
            "android.permission.RECORD_AUDIO",
            "android.permission.MODIFY_AUDIO_SETTINGS",
            "android.permission.FOREGROUND_SERVICE",
            "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
            "android.permission.FOREGROUND_SERVICE_MICROPHONE",
            "android.permission.POST_NOTIFICATIONS"
          ],
          "androidForegroundService": true,
          "androidFSTypes": ["mediaPlayback", "microphone"],
          "androidFSStopWithTask": true
        }
      ],
      "expo-router",
      "expo-asset",
      "expo-sharing",
      "./plugins/with-production-faults"
    ]
  }
}

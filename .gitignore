.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Selected from the installed Audio API package by postinstall
src/audio/build-info.json

# Native test helper build output
/tools/audio-interrupter/.gradle/
/tools/audio-interrupter/build/
/tools/audio-interrupter/app/build/

# Generated outputs of the local Expo module
/modules/**/android/build/
/modules/**/android/.gradle/

# Local investigation history and device automation (keep on disk, not GitHub)
/docs/
/archive/
/.argent/

# The public usage guide is the only Markdown document in this repository.
# AGENTS.md remains available locally for project instructions.
*.md
!/README.md


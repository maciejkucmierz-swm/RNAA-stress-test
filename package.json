{
  "name": "rnaa-stress-test",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.30",
    "expo-asset": "~57.0.20",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-sharing": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-audio-api": "0.13.6",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "node scripts/audio-version.mjs",
    "prestart": "node scripts/audio-version.mjs",
    "preandroid": "node scripts/audio-version.mjs",
    "preios": "node scripts/audio-version.mjs",
    "start": "expo start --dev-client",
    "android": "expo run:android --device",
    "ios": "expo run:ios --device",
    "android:release": "expo run:android --device --variant release",
    "ios:release": "expo run:ios --device --configuration Release",
    "prebuild": "expo prebuild",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "fixtures": "python3 scripts/generate-fixtures.py",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:config": "node scripts/check-config.mjs",
    "stress:server": "node scripts/stress-server.mjs",
    "stress:host": "node scripts/stress-host.mjs",
    "production:reset": "node scripts/production-reset.mjs",
    "production:interrupter": "node scripts/production-interrupter.mjs",
    "check:audio-integrity": "node scripts/check-audio-integrity.mjs",
    "preandroid:release": "node scripts/audio-version.mjs",
    "preios:release": "node scripts/audio-version.mjs",
    "typecheck:tests": "tsc --project tsconfig.tests.json --noEmit",
    "check:tools": "node scripts/check-tools.mjs",
    "format": "npm exec --yes --package=prettier@3.6.2 -- prettier --write src tests scripts/*.mjs plugins/*.js *.js *.json .github/workflows/*.yml README.md",
    "format:check": "npm exec --yes --package=prettier@3.6.2 -- prettier --check src tests scripts/*.mjs plugins/*.js *.js *.json .github/workflows/*.yml README.md",
    "typecheck:tools": "tsc --project tsconfig.tools.json --noEmit"
  },
  "private": true
}
